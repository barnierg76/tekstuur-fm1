diff --git a/tests/tekstuur_test.c b/tests/tekstuur_test.c
new file mode 100644
index 0000000..d41641f
--- /dev/null
+++ b/tests/tekstuur_test.c
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* The Tekstuur build (FELUCCA_TEKSTUUR=1, this fork): the whole instrument is TEXTURE.
+ *   cc -DFELUCCA_TEKSTUUR=1 ... -o build/host/tekstuur_test tests/tekstuur_test.c && build/host/tekstuur_test
+ * power-on   four tracks, all TEXTURE, the four layer presets
+ * one engine nothing else can be picked (the PRESETS knob, the EDIT layer, the editor's SET, an old favourite)
+ * presets    the PRESETS list is TEXTURE's and wraps inside it
+ * foreign    a project and a sound of another engine load as TEXTURE with its defaults, the steps and mix kept
+ * (built with -DFELUCCA_TEKSTUUR=0 it fails: the proof the checks see the difference) */
+#define UI_TEST_NO_MAIN 1
+#include "ui_test.c"
+
+static int tk(const char *what, int ok)
+{
+    printf("tekstuur: %-66s %s\n", what, ok ? "ok" : "FAIL");
+    return !ok;
+}
+
+int main(void)
+{
+    int bad = 0;
+    uint32_t i, ok, total = 0;
+    static project_t q;
+    ui_power_on();
+    for (ok = 1, i = 0; i < NTRK; i++)
+        ok &= trk[i].eng_req == 14u && trk[i].preset == i;
+    bad += tk("power-on: four layers, TEXTURE, presets 0..3", ok);
+    bad += tk("one engine to pick, and it is TEXTUR", NENG_SHOWN == 1 && eng_vis(0) == 14u &&
+              str_eq(ENGINES[14]->name, "TEXTUR"));
+    for (ok = 1, i = 0; i < NENGINES; i++)
+        ok &= eng_ok(i) == (i == 14u) && eng_step(i, 1) == 14u && eng_step(i, -1) == 14u;
+    bad += tk("no other engine is selectable, stepping stays on TEXTURE", ok);
+    for (ok = 1, i = 0; i < NENGINES; i++) {
+        set_engine(i);
+        ok &= TSEL->eng_req == 14u;
+    }
+    bad += tk("asking for any engine (the editor, a favourite) gives TEXTURE", ok);
+    preset_all_pos(&total);
+    bad += tk("PRESETS lists TEXTURE's presets (and the user's), ten factory", ENGINES[14]->npresets == 10u &&
+              total >= 10u && total < 10u + 64u);
+    /* a project of the full Felucca: other engines, their values */
+    ui_power_on();
+    trk[1].step[3].n = 1;
+    trk[1].p[P_LEVEL] = 77;
+    project_capture(&q);
+    for (i = 0; i < NTRK; i++) {
+        q.t[i].engine = (uint8_t)(i == 3u ? ENGI_DRUM : i);       /* ANALOG, (DIGITAL), PHASE, DRUM */
+        q.t[i].p[P_E0] = 1;
+        q.t[i].p[P_E3] = 99;
+    }
+    q.t[1].engine = ENGI_FM6;
+    q.sum = proj_sum(&q);
+    bad += tk("the foreign project is accepted", project_restore_runtime(&q) == 0);
+    for (ok = 1, i = 0; i < NTRK; i++) {
+        uint32_t k;
+        ok &= trk[i].eng_req == 14u;
+        for (k = 0; k < 8u; k++)
+            ok &= trk[i].p[P_E0 + k] == ENGINES[14]->edit[k].def;
+    }
+    bad += tk(".. every track TEXTURE with its default sound", ok);
+    bad += tk(".. the steps and the mix kept", trk[1].step[3].n == 1 && trk[1].p[P_LEVEL] == 77);
+    printf(bad ? "tekstuur: FAILED\n" : "tekstuur: all ok\n");
+    return bad != 0;
+}
diff --git a/tests/texture_test.c b/tests/texture_test.c
new file mode 100644
index 0000000..19c4239
--- /dev/null
+++ b/tests/texture_test.c
@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* TEXTURE (eng_texture.c, this fork) on the host, the firmware's own sources through hostsim.c:
+ *   build/host/texture_test [DEMO_DIR]
+ * seam    per head the windows of its passes sum to 1 at every block border (built with -DTX_TEST_NO_LATE it fails)
+ * rate    a note at the zone's root reads at the zone's rate, the octave head at twice that (or folded down)
+ * pool    three held notes: never more than TX_NP passes, no voice without one, every head keeps running
+ * evolve  EVOL's travel covers most of its range in 80 s
+ * cost    render time against GRAIN's CLOUD PAD, three held notes
+ * DEMO_DIR: 40 s of each preset, one held chord, into WAVs */
+#include <stdint.h>
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+
+static int fails;
+static void check(const char *what, int ok, double a, double b)
+{
+    printf("texture: %-58s %-4s (%.3f, %.3f)\n", what, ok ? "ok" : "FAIL", a, b);
+    fails += !ok;
+}
+static void setup(uint32_t eng, uint32_t preset)
+{
+    uint32_t i;
+    host_tracks_init();
+    host_preset(&trk[0], eng, preset);
+    for (i = 0; i < 4u; i++)
+        trk[0].p[P_DIST + i] = 0;
+    trk[0].p[P_ATK] = 0;
+    trk[0].p[P_SUS] = 127;
+}
+static void blocks(uint32_t n, int32_t *peak)
+{
+    uint32_t k, i;
+    for (k = 0; k < n; k++) {
+        int32_t o[2 * CTL];
+        mix_block(o, CTL);
+        for (i = 0; peak && i < 2 * CTL; i++)
+            if (abs(o[i]) > *peak)
+                *peak = abs(o[i]);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    track_t *t = &trk[0];
+    tx_part_t *P;
+    uint32_t k, i, h;
+    /* seam */
+    {
+        int32_t lo = 1 << 30, hi = 0, peak = 0;
+        setup(14, 0);
+        t->p[P_E5] = 127; t->p[P_E6] = 127; t->p[P_E2] = 70;
+        trk_note_on(t, 60, 100);
+        P = tx_of(t);
+        blocks(3u * FS / CTL, &peak);
+        for (k = 0; k < 20u * FS / CTL; k++) {
+            blocks(1, &peak);
+            for (h = 0; h < TX_HEADS; h++) {
+                int32_t sum = 0;
+                for (i = 0; i < TX_NP; i++)
+                    if (P->p[i].owner && P->p[i].head == h)
+                        sum += tx_win(&P->p[i], P->p[i].left);
+                if (sum < lo) lo = sum;
+                if (sum > hi) hi = sum;
+            }
+        }
+        check("seam: a head's windows sum to 1 (ripple %, peak)", (hi - lo) < 32767 * 0.005 && hi < 32767 * 1.005 && peak > 1000,
+              100.0 * (hi - lo) / 32767.0, (double)peak);
+        trk_note_off(t, 60);
+    }
+    /* rate */
+    {
+        const smp_zone_t *z;
+        uint32_t s0 = 0, s1 = 0, root;
+        setup(14, 1);                                   /* OCTAVES: heads 0, +12, -12 */
+        t->p[P_E5] = 0;
+        z = gr_zone((uint32_t)t->p[P_E0], 0);
+        root = (uint32_t)(z->root16 / 16);
+        trk_note_on(t, root, 100);
+        P = tx_of(t);
+        blocks(2u * FS / CTL, 0);
+        for (i = 0; i < TX_NP; i++)
+            if (P->p[i].owner && P->p[i].head == 0) s0 = P->p[i].step;
+            else if (P->p[i].owner && P->p[i].head == 2) s1 = P->p[i].step;
+        check("rate: root note reads at the zone's rate, -12 at half", s0 && s1 && fabs((double)s0 / z->rate - 1) < 0.01
+              && fabs((double)s1 / z->rate - 0.5) < 0.01, (double)s0 / z->rate, (double)s1 / z->rate);
+        trk_note_off(t, root);
+    }
+    /* pool */
+    {
+        uint32_t peak = 0, silent = 0;
+        setup(14, 0);
+        trk_note_on(t, 55, 100); trk_note_on(t, 60, 100); trk_note_on(t, 64, 100);
+        P = tx_of(t);
+        for (k = 0; k < 30u * FS / CTL; k++) {
+            uint32_t own[NVOICE] = {0}, used = 0;
+            blocks(1, 0);
+            for (i = 0; i < TX_NP; i++)
+                if (P->p[i].owner) { used++; own[P->p[i].owner - 1]++; }
+            if (used > peak) peak = used;
+            if (k > 3u * FS / CTL)
+                for (i = 0; i < TX_POLY; i++)
+                    silent += t->v[i].active && !own[i];
+        }
+        check("pool: three notes (peak passes, blocks with a silent voice)", peak <= TX_NP && !silent, (double)peak, (double)silent);
+    }
+    /* evolve */
+    {
+        int32_t lo = 1 << 30, hi = -(1 << 30);
+        for (k = 0; k < 80u * FS / CTL; k++) {
+            int32_t e;
+            texture_block(t);
+            e = tx_evolve(P);
+            if (e < lo) lo = e;
+            if (e > hi) hi = e;
+        }
+        check("evolve: travel in 80 s (of 65535)", hi - lo > 40000, (double)(hi - lo), 0);
+    }
+    /* cost */
+    {
+        clock_t c0;
+        double tt, tg;
+        setup(14, 0);
+        trk_note_on(t, 55, 100); trk_note_on(t, 60, 100); trk_note_on(t, 64, 100);
+        blocks(2u * FS / CTL, 0);
+        c0 = clock(); blocks(120u * FS / CTL, 0); tt = (double)(clock() - c0) / CLOCKS_PER_SEC;
+        setup(8, 0);
+        trk_note_on(t, 55, 100); trk_note_on(t, 60, 100); trk_note_on(t, 64, 100);
+        blocks(2u * FS / CTL, 0);
+        c0 = clock(); blocks(120u * FS / CTL, 0); tg = (double)(clock() - c0) / CLOCKS_PER_SEC;
+        check("cost: render time against GRAIN (ratio, GRAIN ms / 120 s)", tt / tg < 1.15, tt / tg, tg * 1000);
+    }
+    if (argc > 1) {
+        uint32_t pr;
+        for (pr = 0; pr < ENGINES[14]->npresets; pr++) {
+            char path[512];
+            FILE *w;
+            uint32_t frames = 40u * FS;
+            snprintf(path, sizeof path, "%s/texture_%u.wav", argv[1], pr);
+            w = fopen(path, "wb");
+            if (!w) continue;
+            host_tracks_init();
+            host_preset(t, 14, pr);
+            song.master_q12 = 4096;
+            trk_note_on(t, 48, 90); trk_note_on(t, 55, 90); trk_note_on(t, 60, 90);
+            wav_hdr(w, frames);
+            for (k = 0; k < frames / CTL; k++) {
+                int32_t o[2 * CTL];
+                if (k == 34u * FS / CTL) { trk_note_off(t, 48); trk_note_off(t, 55); trk_note_off(t, 60); }
+                mix_block(o, CTL);
+                for (i = 0; i < CTL; i++)
+                    wav_put(w, o[2 * i], o[2 * i + 1]);
+            }
+            fclose(w);
+            printf("texture: wrote %s\n", path);
+        }
+    }
+    printf(fails ? "texture: %d FAILED\n" : "texture: all ok\n", fails);
+    return fails != 0;
+}
