diff --git a/firmware/src/eng_texture.c b/firmware/src/eng_texture.c
new file mode 100644
index 0000000..b87b789
--- /dev/null
+++ b/firmware/src/eng_texture.c
@@ -0,0 +1,299 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* TEXTURE: long loops over the SAMPLE material, after BARNIR's Tekstuur (its Multi-Loop, interval
+ * stacking and Evolve). Not part of upstream Felucca; engine 14 in this build (FELUCCA_TEXTURE, core.h).
+ *
+ * A voice plays up to TX_HEADS loop heads over its zone (the zones, the ADPCM and its seek index are
+ * GRAIN's: eng_grain.c). A head repeats a stretch of the zone: LEN (50 ms .. 4 s) times the head's
+ * ratio (256 : 331 : 199, primes: the three line up again only after hours), at the head's interval
+ * (INTV: unison, octaves, a fifth ...) with a little random detune and position (DRFT). A pass has a
+ * sin^2 ramp of a quarter of its length at both ends and the next pass of the head starts one ramp
+ * before the end: sin^2 + cos^2 = 1, so a head has no seam. Passes start on block borders; a pass
+ * that starts late begins that far into its window and its stretch (else the sum ripples by ~2 %).
+ * EVOL moves the read position through the zone on its own: two triangles of 23 s and 37 s.
+ *
+ * Cost: forward passes only, the same inner loop as a forward grain. A head holds at most two passes
+ * (one ending, one starting), so a voice has TX_NP / 2 / voices heads (3, 3, 2); at most one start per
+ * voice and block. The part's decode load keeps GRAIN's bound (GR_LOAD_MAX): a pass that would break
+ * it plays an octave lower, or waits. State: tx_part_t in the part's engine memory; per voice s[0] the
+ * zone, s[1] s[3] s[4] the heads' countdowns, s[2] the low-pass. */
+#define TX_POLY 3
+#define TX_HEADS 3
+#define TX_NP 12
+
+typedef struct {
+    const smp_zone_t *z;
+    uint32_t pos;                /* the next sample to decode */
+    int32_t frac;                /* Q16 between a and b */
+    uint32_t step;               /* Q16 source samples per output sample */
+    uint32_t len, left, fade;    /* output samples: the pass, to go, each ramp */
+    uint32_t finc;               /* (1 << 22) / fade */
+    int32_t a, b, pred, idx;
+    int32_t gain;                /* Q15 */
+    uint8_t owner;               /* voice index + 1, 0 = free */
+    uint8_t head, zl;
+} tx_pass_t;
+
+typedef struct {
+    gr_part_t G;                 /* GRAIN's seek index (its grain pool and reverse windows stay unused) */
+    tx_pass_t p[TX_NP];
+    uint32_t evo1, evo2;
+} tx_part_t;
+ENG_MEM_FITS("TEXTURE", sizeof(tx_part_t));
+
+static const char *const N_TX_INTV[] = {"UNI", "OCT", "5TH", "OCT5", "SUB"};
+static const uint16_t TX_HRATIO[TX_HEADS] = {256, 331, 199};
+static const int16_t TX_HOFFS[TX_HEADS] = {0, 3700, -2400};          /* against POS, 127 << 8 = the zone */
+static const int8_t TX_INTERVAL[5][TX_HEADS] = {{0, 0, 0}, {0, 12, -12}, {0, 7, -12}, {0, 12, 7}, {0, -12, -24}};
+static const uint8_t TX_SLOT[TX_HEADS] = {1, 3, 4};                  /* voice_t.s[] of a head's countdown */
+
+static tx_part_t *tx_of(const track_t *t) { return (tx_part_t *)ENG_MEM(gr_part(t)); }
+static int32_t tx_tri(uint32_t ph) { uint32_t u = ph >> 15; return (int32_t)(u < 65536u ? u : 131071u - u) - 32768; }
+static int32_t tx_evolve(const tx_part_t *P) { return (tx_tri(P->evo1) * 3 + tx_tri(P->evo2) * 2) / 5; }
+
+static uint32_t tx_heads(const track_t *t)
+{
+    uint32_t i, nact = 0, cap;
+    for (i = 0; i < TX_POLY; i++)
+        nact += t->v[i].active;
+    cap = TX_NP / (nact ? nact : 1u) / 2u;
+    return cap > TX_HEADS ? TX_HEADS : cap < 1u ? 1u : cap;
+}
+
+/* the window of a pass with `left` to go, Q15: GR_HANN's rising half is the sin^2 ramp */
+static inline int32_t tx_win(const tx_pass_t *g, uint32_t left)
+{
+    uint32_t done = g->len - left, k = done < left ? done : left, q, wi;
+    if (k >= g->fade)
+        return 32767;
+    q = (k * g->finc) >> 7;                         /* Q15 through the ramp */
+    wi = q >> 8;
+    return GR_HANN[wi] + (((GR_HANN[wi + 1u] - GR_HANN[wi]) * (int32_t)(q & 255u)) >> 8);
+}
+
+/* start a pass of head h of voice vi, `late` output samples behind its time; returns the samples to
+ * the head's next start, 0 = not now (no free pass, the index not built that far, the load): try again */
+static uint32_t tx_spawn(tx_part_t *P, const track_t *t, uint32_t vi, uint32_t zl, uint32_t h, uint32_t heads,
+                         uint32_t late, const vmod_t *m)
+{
+    const int16_t *p = t->p;
+    const smp_zone_t *z = gr_zone(P->G.src - 1u, zl);
+    tx_pass_t *g = 0;
+    uint32_t i, n = z->n, len, step, span, fade, load, r1 = gr_rnd(t), r2 = gr_rnd(t);
+    int32_t d16, posq, pos;
+    uint64_t adv;
+    for (i = 0; i < TX_NP && !g; i++)
+        if (!P->p[i].owner)
+            g = &P->p[i];
+    if (!g || n < 64u || !P->G.zcnt[zl])
+        return 0;
+    /* length: 2205 * 2^(LEN / 20) output samples (50 ms .. 4 s), times the head's ratio */
+    len = (2205u * (pow2_q16((p[P_E2] * 153) >> 4) >> 4)) >> 12;
+    len = (len * TX_HRATIO[h]) >> 8;
+    /* rate: the note against the zone's root, PTCH, the head's interval, DRFT^2 up to +-50 cents */
+    d16 = m->pitch16 - z->root16 + p[P_E4] * 16 + TX_INTERVAL[clamp(p[P_E3], 0, 4)][h] * 16
+        + ((((int32_t)(r1 & 0xFFFFu) - 32768) * (p[P_E5] * p[P_E5] * 8 / (127 * 127))) >> 15);
+    step = (pow2_q16(clamp(d16, -1536, 576)) >> 8) * (z->rate >> 8);
+    while (step > GR_STEP_MAX)                      /* the decoder's rate cap: an octave down */
+        step >>= 1;
+    for (i = 0, load = 0; i < TX_NP; i++)           /* the part's decode load, as GRAIN's */
+        if (P->p[i].owner)
+            load += P->p[i].step;
+    while (load + step > GR_LOAD_MAX && step > 32768u)
+        step >>= 1;
+    if (load + step > GR_LOAD_MAX)
+        return 0;
+    step = step < 256u ? 256u : step;
+    span = (uint32_t)(((uint64_t)len * step) >> 16);
+    if (span + 3u > n) {                            /* a short zone: a shorter pass */
+        span = n - 3u;
+        len = (uint32_t)(((uint64_t)span << 16) / step);
+    }
+    if (len < 128u)
+        return 0;
+    fade = len >> 2;
+    /* position: POS (+ the SHP modulation) + EVOL, the head's offset, DRFT jitters it by up to +-6 % */
+    posq = (p[P_E1] << 8) + m->shape - (64 << 8) + ((tx_evolve(P) * p[P_E6]) >> 8) + TX_HOFFS[h]
+         + ((((int32_t)(r2 & 0xFFFFu) - 32768) * p[P_E5]) >> 11);
+    posq = clamp(posq, 0, 127 << 8);
+    pos = (int32_t)gr_scale(n - 1u, (uint32_t)posq * 65535u / (127u << 8)) - (int32_t)(span >> 1);
+    pos = clamp(pos, 0, (int32_t)(n - 3u - span));
+#ifdef TX_TEST_NO_LATE                               /* tests/texture_test.c: the seam test must fail without this */
+    late = 0;
+#endif
+    if (late >= fade)
+        late = fade - 1u;
+    adv = (uint64_t)late * step;
+    pos += (int32_t)(adv >> 16);
+    if ((uint32_t)pos >> GR_SEG_LOG2 >= P->G.zdone[zl])
+        return 0;                                   /* not indexed yet */
+    g->z = z;
+    g->zl = (uint8_t)zl;
+    g->step = step;
+    g->frac = (int32_t)(adv & 0xFFFFu);
+    g->len = len;
+    g->left = len - late;
+    g->fade = fade;
+    g->finc = (1u << 22) / fade;
+    g->gain = heads >= 3u ? 18918 : heads == 2u ? 23170 : 32767;   /* 1 / sqrt(heads) */
+    g->head = (uint8_t)h;
+    gr_seek(&P->G, z, zl, (uint32_t)pos, &g->pred, &g->idx);
+    g->a = gr_dec(z, (uint32_t)pos, &g->pred, &g->idx);
+    g->b = gr_dec(z, (uint32_t)pos + 1u, &g->pred, &g->idx);
+    g->pos = (uint32_t)pos + 2u;
+    g->owner = (uint8_t)(vi + 1u);
+    return len - fade;
+}
+
+/* one pass into acc: the window (times the level) is a linear ramp over the block */
+static void tx_run(tx_pass_t *g, int32_t *acc, uint32_t n)
+{
+    uint32_t i, m = n < g->left ? n : g->left, step = g->step, pos = g->pos;
+    int32_t a = g->a, b = g->b, frac = g->frac, pred = g->pred, idx = g->idx, w0, w1, wq, dq;
+    const smp_zone_t *z = g->z;
+    w0 = mulq15(tx_win(g, g->left), g->gain);
+    g->left -= m;
+    w1 = g->left ? mulq15(tx_win(g, g->left), g->gain) : 0;
+    wq = w0 * 1024;
+    dq = m == CTL ? ((w1 - w0) * 1024) >> CTL_LOG2 : m ? (w1 - w0) * 1024 / (int32_t)m : 0;
+    for (i = 0; i < m; i++) {
+        int32_t s = a + (((b - a) * (frac >> 1)) >> 15);
+        acc[i] += (s * (wq >> 10)) >> 15;
+        wq += dq;
+        frac += (int32_t)step;
+        while (frac >= 65536) {
+            frac -= 65536;
+            a = b;
+            b = pos < z->n ? gr_dec(z, pos++, &pred, &idx) : a;
+        }
+    }
+    g->pos = pos;
+    g->a = a;
+    g->b = b;
+    g->frac = frac;
+    g->pred = pred;
+    g->idx = idx;
+    if (!g->left)
+        g->owner = 0;
+}
+
+static void texture_note_on(track_t *t, voice_t *v)
+{
+    tx_part_t *P = tx_of(t);
+    uint32_t vi = (uint32_t)(v - t->v) % NVOICE, i;
+    v->s[0] = gr_find((uint32_t)t->p[P_E0] % SMP_NALL, v->note);
+    v->ph[0] = 0;
+    if (!v->env) {                                  /* a fresh voice: its heads enter a quarter second apart */
+        for (i = 0; i < TX_NP; i++)
+            if (P->p[i].owner == vi + 1u)
+                P->p[i].owner = 0;
+        for (i = 0; i < TX_HEADS; i++)
+            v->s[TX_SLOT[i]] = (int32_t)(i * (FS / 4u));
+        v->s[2] = 0;
+    }
+}
+
+/* per part and block: the index follows SRC (GRAIN's), passes of ended voices go, EVOL's phases run */
+static void texture_block(track_t *t)
+{
+    tx_part_t *P = tx_of(t);
+    uint32_t src = (uint32_t)t->p[P_E0] % SMP_NALL, st = gr_stamp(src), i;
+    if (!gr_rng[gr_part(t)])
+        gr_rng[gr_part(t)] = 0x2545F491;
+    if (P->G.src != src + 1u || P->G.stamp != st) {
+        gr_reset(&P->G, src, st);
+        for (i = 0; i < TX_NP; i++)
+            P->p[i].owner = 0;
+        for (i = 0; i < NVOICE; i++)
+            if (t->v[i].active)
+                t->v[i].s[0] = gr_find(src, t->v[i].note);
+    }
+    for (i = 0; i < TX_NP; i++)
+        if (P->p[i].owner && !t->v[(P->p[i].owner - 1u) % NVOICE].active)
+            P->p[i].owner = 0;
+    gr_build(&P->G, t);
+    P->evo1 += 4234u * CTL;                         /* 23 s a turn */
+    P->evo2 += 2632u * CTL;                         /* 37 s */
+}
+
+static void texture_render(track_t *t, voice_t *v, int32_t *out, uint32_t n, const vmod_t *m)
+{
+    tx_part_t *P = tx_of(t);
+    const int16_t *p = t->p;
+    uint32_t vi = (uint32_t)(v - t->v) % NVOICE, i, h, heads, started = 0;
+    int32_t zl = v->s[0], acc[CTL], lp, y = v->s[2];
+    if (n > CTL)
+        n = CTL;
+    lp = 4000 + ((clamp((p[P_E7] << 8) + m->cutoff, 0, 127 << 8) * 28767) >> 15);
+    if (zl == GR_SINE) {                            /* no data: a plain sine, as GRAIN */
+        smp_sine(out, n, m, p[P_E4] * 16, lp, &v->ph[0], &v->s[2]);
+        return;
+    }
+    if (zl < 0 || zl >= P->G.nz || P->G.src != (uint32_t)p[P_E0] % SMP_NALL + 1u) {
+        if (zl < 0)
+            v->active = 0;
+        return;
+    }
+    for (i = 0; i < n; i++)
+        acc[i] = 0;
+    for (i = 0; i < TX_NP; i++)
+        if (P->p[i].owner == vi + 1u)
+            tx_run(&P->p[i], acc, n);
+    heads = tx_heads(t);
+    for (h = 0; h < TX_HEADS; h++) {
+        int32_t *c = &v->s[TX_SLOT[h]];
+        *c -= (int32_t)n;
+        if (h >= heads) {
+            if (*c < 0)
+                *c = 0;
+        } else if (*c <= 0 && !started) {
+            uint32_t per = tx_spawn(P, t, vi, (uint32_t)zl, h, heads, (uint32_t)-*c, m);
+            if (per) {
+                *c += (int32_t)per;
+                started = 1;
+            } else if (*c < -(int32_t)FS)
+                *c = -(int32_t)FS;
+        }
+    }
+    for (i = 0; i < n; i++) {
+        y += mulq15(clamp(acc[i], -65535, 65535) - y, lp);
+        out[i] += voice_amp(y, m, i) << 1;
+    }
+    v->s[2] = y;
+}
+
+static const preset_t TEXTURE_PRESETS[] = {
+    /* name, {SRC, POS, LEN, INTV, PTCH, DRFT, EVOL, TONE}, {A D S R}, fenv, mono */
+    {"SLOW TIDE", {2, 50, 100, 0, 0, 40, 60, 100}, {80, 90, 127, 100}, 0, 0, FX(0, 40, 25, 85), PAT(5)},
+    {"OCTAVES", {0, 45, 92, 1, 0, 50, 90, 105}, {70, 90, 127, 100}, 0, 0, FX(0, 30, 20, 90), PAT(5)},
+    {"FIFTH SKY", {2, 50, 84, 2, 0, 45, 80, 95}, {70, 90, 127, 100}, 0, 0, FX(0, 40, 30, 90), PAT(5)},
+    {"DEEP", {0, 40, 104, 4, 0, 60, 70, 70}, {90, 90, 127, 110}, 0, 0, FX(0, 20, 20, 95), PAT(8)},
+    {"GLASS", {0, 70, 62, 3, 12, 30, 100, 122}, {40, 90, 127, 95}, 0, 0, FX(0, 25, 35, 90), PAT(5)},
+    {"REED FOG", {3, 45, 98, 0, 0, 75, 70, 82}, {90, 90, 127, 105}, 0, 0, FX(0, 45, 20, 95), PAT(5)},
+    {"SUB DRONE", {3, 35, 110, 4, -12, 55, 50, 58}, {100, 90, 127, 115}, 0, 0, FX(0, 15, 10, 80), PAT(8)},
+    {"BREATH", {2, 60, 72, 1, 0, 35, 115, 112}, {60, 90, 127, 100}, 0, 0, FX(0, 35, 30, 95), PAT(5)},
+    {"STILL", {4, 50, 104, 0, 0, 10, 20, 96}, {85, 90, 127, 110}, 0, 0, FX(0, 20, 15, 70), PAT(5)},
+    {"WIDE FIFTH", {3, 55, 88, 2, 0, 60, 95, 100}, {75, 90, 127, 105}, 0, 0, FX(0, 40, 30, 100), PAT(5)},
+};
+
+static const engine_t ENG_TEXTURE = {
+    .name = "TEXTUR",
+    .page_title = {"LOOP", "MOVE"},
+    .edit = {
+        {"SRC", F_ENUM, 0, SMP_NALL - 1, 0, SMP_ALL_NAMES, 0},
+        {"POS", F_PCT, 0, 127, 50, 0, 0},
+        {"LEN", F_PCT, 0, 127, 90, 0, 0},
+        {"INTV", F_ENUM, 0, 4, 0, N_TX_INTV, 0},
+        {"PTCH", F_SEMI, -24, 24, 0, 0, 0},
+        {"DRFT", F_PCT, 0, 127, 40, 0, 0},
+        {"EVOL", F_PCT, 0, 127, 60, 0, 0},
+        {"TONE", F_PCT, 0, 127, 110, 0, 0},
+    },
+    .presets = TEXTURE_PRESETS,
+    .npresets = NELEM(TEXTURE_PRESETS),
+    .note_on = texture_note_on,
+    .render = texture_render,
+    .knob = {P_E1, P_E2, P_E5, P_E6},
+    .poly = TX_POLY,
+    .block = texture_block,
+    .mem = sizeof(tx_part_t),
+};
