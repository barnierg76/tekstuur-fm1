diff --git a/firmware/src/ui_draw.c b/firmware/src/ui_draw.c
index 762d5a9..7b9b29f 100644
--- a/firmware/src/ui_draw.c
+++ b/firmware/src/ui_draw.c
@@ -1361,7 +1361,11 @@ static void draw_columns(void)
 #define SPL_X0 ((240u - SPL_SQ) / 2u)               /* its top-left on the screen (x and y) */
 #define SPL_PAD 16                                  /* the text's inset: left (its ink), top and bottom (the capitals) */
 #define SPL_PITCH 20                                /* line to line */
+#if FELUCCA_TEKSTUUR
+static const char *const SPLASH_LINES[] = {"Tekstuur", TEKSTUUR_VERSION, "BARNIR", "built on Felucca"};
+#else
 static const char *const SPLASH_LINES[] = {"Felucca", FELUCCA_VERSION, "H\xFCgelton Instruments", "with community"};
+#endif
 /* a band of two lines, h tall, at y on the screen: the first line's top at ly; the two lines' capitals declared
  * against al0..al1 (mode: AL_V the band centred there, AL_B the last baseline on al1) */
 static void splash_band(uint32_t y, uint32_t h, int32_t ly, const char *const *l, uint32_t mode, int32_t al0,
@@ -1373,6 +1377,37 @@ static void splash_band(uint32_t y, uint32_t h, int32_t ly, const char *const *l
     cv_text_on(SPL_PAD, ly + SPL_PITCH, &AF_M, l[1], T_TEXT, T_RAISE);
     cv_blit(SPL_X0, y);
 }
+#if FELUCCA_TEKSTUUR
+#include "tekstuur_logo.h"
+/* a wordmark bitmap (tools/gen_tekstuur_logo.py: 4 bits a pixel, TK_LOGO_PAL) into the canvas at x, y; the paper's
+ * pixels (colour 0) are left as they are */
+static void tk_logo(int32_t x, int32_t y, const uint8_t *px, uint32_t w, uint32_t h)
+{
+    uint32_t i, j;
+    for (j = 0; j < h; j++)
+        for (i = 0; i < w; i++) {
+            uint32_t b = px[(j * w + i) >> 1], v = i & 1u ? b & 15u : b >> 4;
+            if (v)
+                cv_pset(x + (int32_t)i, y + (int32_t)j, TK_LOGO_PAL[v]);
+        }
+}
+/* Tekstuur's splash: the plug-in's dark paper over the whole screen (its own colours, whatever COLOR is), the
+ * wordmark across it with the four layers' ink dots, the maker and the version under it. (Felucca, which this is
+ * built on, and its licence: MENU > ABOUT, ui_menu.c) */
+static void draw_splash(void)
+{
+    uint16_t paper = TK_LOGO_PAL[0], white = RGB(0xf1, 0xe9, 0xda), dim = RGB(0x7d, 0x78, 0x88);
+    lcd_fill(0, 0, 240, 240, paper);
+    cv_begin(240, TK_LOGO_H, paper);
+    tk_logo((240 - TK_LOGO_W) / 2, 0, TK_LOGO_PX, TK_LOGO_W, TK_LOGO_H);
+    cv_blit(0, 52);
+    cv_begin(240, 46, paper);
+    cv_text_on(10, 0, &AF_M, "by BARNIR", white, paper);
+    cv_text_on(10, 24, &AF_S, TEKSTUUR_VERSION, dim, paper);
+    cv_blit(0, 176);
+    lcd_sync();
+}
+#else
 static void draw_splash(void)
 {
     int32_t h = SPL_PAD - AF_M_CAP_Y + SPL_PITCH + AF_M.h;     /* a band: its two lines, the descenders in */
@@ -1385,6 +1420,7 @@ static void draw_splash(void)
                 "splash maker's baseline SPL_PAD from the bottom");
     lcd_sync();
 }
+#endif
 
